# Backend environment configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# URL of the frontend, used for CORS.
FRONTEND_URL="http://localhost:5173"

# Port the API listens on.
PORT=3000

# PostgreSQL connection string. Required for `db:migrate` and at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wanderhub?schema=public"
