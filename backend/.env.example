# Backend environment configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# URL of the frontend, used for CORS.
FRONTEND_URL="http://localhost:5173"

# Port the API listens on.
PORT=3000

# PostgreSQL connection string. Required for `db:migrate` and at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wanderhub?schema=public"

# Sentry error tracking DSN (optional — omit to disable).
SENTRY_DSN=

# SMTP email transport for outbound notification emails (optional — omit to disable).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# SMTP_FROM="NawaHub <noreply@example.com>"

# Public URL of the frontend — used in email action links.
APP_URL="http://localhost:5173"

# Shared secret protecting the internal cron endpoint (/api/internal/cron/run).
# Required to enable scheduled overdue sweeps + email delivery on serverless.
# Generate like JWT_SECRET. Vercel Cron sends it as `Authorization: Bearer`.
CRON_SECRET=
