# Production backend profile.
# Copy to `.env.production` and fill in real secrets. Never commit `.env.production`.

NODE_ENV=production
PORT=3000
FRONTEND_URL="https://your-domain.example"
APP_URL="https://your-domain.example"

JWT_SECRET=

# For Supabase + Prisma:
# - DATABASE_URL should be the pooled runtime URL.
# - DIRECT_URL should be the direct/session URL for Prisma migrations.
# - Percent-encode special password characters in URLs, e.g. + -> %2B and ? -> %3F.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

SENTRY_DSN=
CRON_SECRET=
UPLOAD_DIR="./uploads"

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# SMTP_FROM="NawaHub <noreply@example.com>"
