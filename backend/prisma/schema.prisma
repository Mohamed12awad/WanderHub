generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Schema conventions ───────────────────────────────────────────────────────
//
// Aggregate-root models (Customer, Deal, Lead, Invoice, Quote, ExpenseReport,
// PurchaseOrder, VendorBill, Project, Task, …) carry:
//   createdAt  DateTime  @default(now())
//   updatedAt  DateTime  @updatedAt
//   deletedAt  DateTime? — soft-delete; all services filter `deletedAt: null`
//
// Child / line-item models (*LineItem, ProjectMember, InvoicePayment, …) carry
// only what they need; omitting updatedAt/deletedAt is intentional.
//
// ─── Enums ───────────────────────────────────────────────────────────────────

enum DealStatus {
  lead
  qualified
  proposal
  negotiation
  won
  lost
  cancelled
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  cancelled
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ActivityType {
  call
  meeting
  task
  note
  email
}

enum ActivityStatus {
  pending
  completed
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  todo
  in_progress
  review
  done
  cancelled
}

enum LeadStatus {
  new
  contacted
  nurturing
  qualified
  unqualified
  converted
}

enum LeadRating {
  cold
  warm
  hot
}

enum NotificationType {
  task_assigned
  deal_assigned
  lead_assigned
  approval_requested
  approval_approved
  approval_rejected
  invoice_overdue
  bill_overdue
}

enum PurchaseOrderStatus {
  draft
  sent
  confirmed
  received
  cancelled
}

enum BillStatus {
  draft
  received
  partially_paid
  paid
  overdue
  cancelled
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

enum MilestoneStatus {
  pending
  in_progress
  completed
}

// ─── Auth & Config ────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String
  password    String
  active      Boolean  @default(true)
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id])
  reportsToId String?
  reportsTo   User?    @relation("ReportsTo", fields: [reportsToId], references: [id])
  directReports User[] @relation("ReportsTo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedCustomers         Customer[]         @relation("CustomerOwner")
  ownedDeals             Deal[]             @relation("DealOwner")
  createdQuotes          Quote[]            @relation("QuoteCreatedBy")
  approvedQuotes         Quote[]            @relation("QuoteApprovedBy")
  createdInvoices        Invoice[]          @relation("InvoiceCreatedBy")
  approvedInvoices       Invoice[]          @relation("InvoiceApprovedBy")
  invoicePayments        InvoicePayment[]
  expenseReports         ExpenseReport[]    @relation("ExpenseUser")
  approvedExpenses       ExpenseReport[]    @relation("ExpenseApprovedBy")
  assignedActivities     Activity[]         @relation("ActivityAssignedTo")
  createdActivities      Activity[]         @relation("ActivityCreatedBy")
  notes                  Note[]
  assignedTasks          Task[]             @relation("TaskAssignedTo")
  createdTasks           Task[]             @relation("TaskCreatedBy")
  triggeredTimelines     TimelineEvent[]
  logs                   Log[]
  refreshTokens          RefreshToken[]
  ownedLeads             Lead[]             @relation("LeadOwner")
  createdLeads           Lead[]             @relation("LeadCreator")
  notifications          Notification[]
  createdPurchaseOrders  PurchaseOrder[]    @relation("POCreatedBy")
  approvedPurchaseOrders PurchaseOrder[]    @relation("POApprovedBy")
  createdVendorBills     VendorBill[]       @relation("BillCreatedBy")
  approvedVendorBills    VendorBill[]       @relation("BillApprovedBy")
  vendorBillPayments     VendorBillPayment[]
  managedProjects        Project[]          @relation("ProjectManager")
  createdProjects        Project[]          @relation("ProjectCreatedBy")
  projectMemberships     ProjectMember[]
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Customer {
  id                     String    @id @default(cuid())
  name                   String
  phone                  String    @unique
  mobile                 String?
  email                  String?   @unique
  // Embedded objects stored as JSON
  address                Json?
  identification         Json?
  dateOfBirth            DateTime?
  gender                 String?
  preferredContactMethod String?
  paymentInformation     Json?
  loyaltyProgram         Json?
  emergencyContact       Json?
  location               String?
  ownerId                String?
  owner                  User?     @relation("CustomerOwner", fields: [ownerId], references: [id])
  source                 String?
  status                 String?
  notes                  String?
  customFields           Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  deals         Deal[]
  quotes        Quote[]
  invoices      Invoice[]
  activities    Activity[]
  customerNotes Note[]
  timelines     TimelineEvent[]
  fromLead      Lead?           @relation("LeadConversion")
  projects      Project[]

  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model Deal {
  id                String     @id @default(cuid())
  customerId        String
  customer          Customer   @relation(fields: [customerId], references: [id])
  ownerId           String?
  owner             User?      @relation("DealOwner", fields: [ownerId], references: [id])
  title             String
  category          String?
  dealType          String?
  price             Float
  currency          String     @default("EGP")
  status            DealStatus @default(lead)
  priority          String?    @default("medium")
  probability       Float?     @default(10)
  source            String?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  customFields      Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  quotes          Quote[]
  invoices        Invoice[]
  activities      Activity[]
  dealNotes       Note[]
  timelines       TimelineEvent[]
  tasks           Task[]
  project         Project?

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model Lead {
  id                 String      @id @default(cuid())
  name               String
  company            String?
  jobTitle           String?
  phone              String?
  email              String?
  mobile             String?
  website            String?
  city               String?
  country            String?
  source             String?
  campaign           String?
  status             LeadStatus  @default(new)
  rating             LeadRating?
  budget             Float?
  currency           String?     @default("EGP")
  expectedCloseDate  DateTime?
  lostReason         String?
  notes              String?
  ownerId            String?
  owner              User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById        String?
  createdBy          User?       @relation("LeadCreator", fields: [createdById], references: [id])
  convertedAt        DateTime?
  convertedToId      String?     @unique
  convertedTo        Customer?   @relation("LeadConversion", fields: [convertedToId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  @@index([ownerId])
  @@index([status])
  @@index([rating])
  @@index([deletedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Product {
  id           String   @id @default(cuid())
  name         String
  type         String?
  capacity     Float?
  location     String?
  description  String?
  notes        String?
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  productNotes Note[]
}

// ─── Finance — Quotes ────────────────────────────────────────────────────────

model Quote {
  id                   String         @id @default(cuid())
  quoteNumber          String         @unique
  title                String
  customerId           String
  customer             Customer       @relation(fields: [customerId], references: [id])
  dealId               String?
  deal                 Deal?          @relation(fields: [dealId], references: [id])
  status               QuoteStatus    @default(draft)
  subtotal             Float          @default(0)
  taxRate              Float          @default(0)
  tax                  Float          @default(0)
  total                Float          @default(0)
  currency             String         @default("EGP")
  validUntil           DateTime?
  notes                String?
  terms                String?
  convertedToInvoiceId String?        @unique
  convertedToInvoice   Invoice?       @relation("QuoteToInvoice", fields: [convertedToInvoiceId], references: [id])
  createdById          String
  createdBy            User           @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  approvalStatus       ApprovalStatus @default(pending)
  approvedById         String?
  approvedBy           User?          @relation("QuoteApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  items QuoteLineItem[]

  @@index([customerId])
  @@index([dealId])
  @@index([status])
  @@index([deletedAt])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  taxCode     String?
  total       Float
  order       Int     @default(0)
}

// ─── Finance — Invoices ──────────────────────────────────────────────────────

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  title           String
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fromQuote       Quote?         @relation("QuoteToInvoice")
  status          InvoiceStatus  @default(draft)
  subtotal        Float          @default(0)
  taxRate         Float          @default(0)
  tax             Float          @default(0)
  total           Float          @default(0)
  totalPaid       Float          @default(0)
  currency        String         @default("EGP")
  exchangeRate    Float?
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  terms           String?
  createdById     String
  createdBy       User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    InvoiceLineItem[]
  payments InvoicePayment[]

  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  taxCode     String?
  total       Float
  order       Int     @default(0)
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("EGP")
  date        DateTime
  method      String   @default("cash")
  reference   String?
  notes       String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@index([accountId])
  @@index([date])
}

// ─── Accounts ─────────────────────────────────────────────────────────────────

enum AccountType {
  bank
  cash
  safe
}

model Account {
  id                 String              @id @default(cuid())
  name               String
  type               AccountType         @default(cash)
  currency           String              @default("EGP")
  balance            Float               @default(0)
  notes              String?
  invoicePayments    InvoicePayment[]
  vendorBillPayments VendorBillPayment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model ExpenseReport {
  id              String         @id @default(cuid())
  title           String
  userId          String
  user            User           @relation("ExpenseUser", fields: [userId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  expenses     ExpenseItem[]
  expenseNotes Note[]

  @@index([userId])
  @@index([projectId])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model ExpenseItem {
  id              String        @id @default(cuid())
  expenseReportId String
  expenseReport   ExpenseReport @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  description     String
  amount          Float
  date            DateTime
  category        String
  beneficiary     String
}

// ─── Activities & Notes ──────────────────────────────────────────────────────

model Activity {
  id           String         @id @default(cuid())
  type         ActivityType
  title        String
  description  String?
  date         DateTime
  status       ActivityStatus @default(pending)
  // Polymorphic link — keep both generic fields and typed FKs
  linkedToId   String
  linkedModel  String
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id])
  dealId       String?
  deal         Deal?          @relation(fields: [dealId], references: [id])
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?          @relation("ActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User           @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([assignedToId])
}

model Note {
  id              String         @id @default(cuid())
  content         String
  linkedToId      String
  linkedModel     String
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  expenseReportId String?
  expenseReport   ExpenseReport? @relation(fields: [expenseReportId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  priority     TaskPriority @default(medium)
  status       TaskStatus   @default(todo)
  dueDate      DateTime?
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  linkedToId   String?
  linkedModel  String?
  dealId       String?
  deal         Deal?        @relation(fields: [dealId], references: [id])
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  tags         String[]
  createdById  String
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([assignedToId])
  @@index([status])
  @@index([projectId])
  @@index([linkedToId, linkedModel])
  @@index([deletedAt])
}

// ─── Timeline ────────────────────────────────────────────────────────────────

model TimelineEvent {
  id            String    @id @default(cuid())
  eventType     String
  title         String
  payload       Json?
  linkedToId    String
  linkedModel   String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  dealId        String?
  deal          Deal?     @relation(fields: [dealId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  triggeredById String?
  triggeredBy   User?     @relation(fields: [triggeredById], references: [id])
  isSystem      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
}

// ─── System ──────────────────────────────────────────────────────────────────

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  method     String
  endpoint   String
  recordId   String?
  recordName String?
  success    Boolean  @default(true)
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([timestamp])
}

// Rotating refresh tokens. Only the SHA-256 hash of the opaque token is
// stored, never the token itself. Rotation revokes the old row and issues a
// new one; logout / deactivation revoke without deleting (audit trail).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model NumberSequence {
  id         String @id @default(cuid())
  key        String @unique
  prefix     String @default("")
  lastNumber Int    @default(0)
  padLength  Int    @default(4)
  separator  String @default("-")
}

model WorkspaceConfig {
  id             String   @id @default(cuid())
  approvals      Json     @default("[]")
  fieldGroups    Json     @default("[]")
  moduleSettings Json     @default("[]")
  baseCurrency   String   @default("EGP")
  locale         String   @default("en-US")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Durable email queue. Notification emails are enqueued here and delivered by
// the scheduler with retry/backoff, so a transient SMTP failure is retried
// instead of silently dropped.
model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  html      String
  status    String    @default("pending") // pending | sent | failed
  attempts  Int       @default(0)
  lastError String?
  sendAfter DateTime  @default(now())
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, sendAfter])
}

// Manual exchange rates used to consolidate multi-currency figures to the
// workspace base currency. `rate` = value of 1 unit of `currency` expressed in
// `baseCurrency`. The latest row (by asOf) per currency is authoritative.
model ExchangeRate {
  id           String   @id @default(cuid())
  currency     String
  baseCurrency String
  rate         Float
  asOf         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([currency, asOf])
}

// ─── Procurement — Suppliers ──────────────────────────────────────────────────

model Supplier {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   Json?
  taxId     String?
  currency  String    @default("EGP")
  notes     String?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]

  @@index([status])
  @@index([deletedAt])
}

// ─── Procurement — Purchase Orders ───────────────────────────────────────────

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique
  title           String
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(draft)
  currency        String              @default("EGP")
  subtotal        Float               @default(0)
  taxRate         Float               @default(0)
  tax             Float               @default(0)
  total           Float               @default(0)
  expectedDate    DateTime?
  notes           String?
  terms           String?
  approvalStatus  ApprovalStatus      @default(pending)
  approvedById    String?
  approvedBy      User?               @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User                @relation("POCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  items PurchaseOrderItem[]
  bills VendorBill[]

  @@index([supplierId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Float
  unitPrice       Float
  discount        Float         @default(0)
  taxRate         Float         @default(0)
  taxCode         String?
  total           Float
  order           Int           @default(0)
}

// ─── Procurement — Vendor Bills ───────────────────────────────────────────────

model VendorBill {
  id              String         @id @default(cuid())
  billNumber      String         @unique
  title           String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  status          BillStatus     @default(draft)
  currency        String         @default("EGP")
  subtotal        Float          @default(0)
  taxRate         Float          @default(0)
  tax             Float          @default(0)
  total           Float          @default(0)
  totalPaid       Float          @default(0)
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  terms           String?
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("BillApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User           @relation("BillCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    VendorBillItem[]
  payments VendorBillPayment[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model VendorBillItem {
  id          String     @id @default(cuid())
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  discount    Float      @default(0)
  taxRate     Float      @default(0)
  taxCode     String?
  total       Float
  order       Int        @default(0)
}

model VendorBillPayment {
  id          String     @id @default(cuid())
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String     @default("EGP")
  date        DateTime
  method      String     @default("cash")
  reference   String?
  notes       String?
  accountId   String?
  account     Account?   @relation(fields: [accountId], references: [id])
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([billId])
  @@index([accountId])
  @@index([date])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(planning)
  priority    String        @default("medium")
  budget      Float?
  currency    String        @default("EGP")
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  dealId      String?       @unique
  deal        Deal?         @relation(fields: [dealId], references: [id])
  managerId   String?
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id])
  createdById String
  createdBy   User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  milestones  ProjectMilestone[]
  members     ProjectMember[]
  tasks       Task[]
  invoices    Invoice[]
  expenses    ExpenseReport[]
  activities  Activity[]
  notes       Note[]
  timelines   TimelineEvent[]

  @@index([customerId])
  @@index([status])
  @@index([managerId])
  @@index([deletedAt])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      MilestoneStatus @default(pending)
  dueDate     DateTime?
  completedAt DateTime?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}
