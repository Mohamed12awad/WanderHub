generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Schema conventions ───────────────────────────────────────────────────────
//
// Aggregate-root models (Customer, Deal, Lead, Invoice, Quote, ExpenseReport,
// PurchaseOrder, VendorBill, Project, Task, …) carry:
//   createdAt  DateTime  @default(now())
//   updatedAt  DateTime  @updatedAt
//   deletedAt  DateTime? — soft-delete; all services filter `deletedAt: null`
//
// Child / line-item models (*LineItem, ProjectMember, InvoicePayment, …) carry
// only what they need; omitting updatedAt/deletedAt is intentional.
//
// ─── Enums ───────────────────────────────────────────────────────────────────

// Dropdown values that were previously Prisma enums (status / priority / type /
// rating / account-type) are now plain String columns. Their options are
// user-configurable at /settings/fields, so the DB no longer constrains them.

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  task_assigned
  deal_assigned
  lead_assigned
  approval_requested
  approval_approved
  approval_rejected
  invoice_overdue
  bill_overdue
}

// ─── Auth & Config ────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id                      String   @id @default(cuid())
  name                    String
  email                   String   @unique
  phone                   String
  password                String
  active                  Boolean  @default(true)
  notificationPreferences Json?
  roleId                  String
  role                    Role     @relation(fields: [roleId], references: [id])
  reportsToId             String?
  reportsTo               User?    @relation("ReportsTo", fields: [reportsToId], references: [id])
  directReports           User[]   @relation("ReportsTo")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  ownedCustomers         Customer[]          @relation("CustomerOwner")
  ownedDeals             Deal[]              @relation("DealOwner")
  createdQuotes          Quote[]             @relation("QuoteCreatedBy")
  approvedQuotes         Quote[]             @relation("QuoteApprovedBy")
  createdInvoices        Invoice[]           @relation("InvoiceCreatedBy")
  approvedInvoices       Invoice[]           @relation("InvoiceApprovedBy")
  invoicePayments        InvoicePayment[]
  expenseReports         ExpenseReport[]     @relation("ExpenseUser")
  approvedExpenses       ExpenseReport[]     @relation("ExpenseApprovedBy")
  assignedActivities     Activity[]          @relation("ActivityAssignedTo")
  createdActivities      Activity[]          @relation("ActivityCreatedBy")
  notes                  Note[]
  assignedTasks          Task[]              @relation("TaskAssignedTo")
  createdTasks           Task[]              @relation("TaskCreatedBy")
  triggeredTimelines     TimelineEvent[]
  logs                   Log[]
  refreshTokens          RefreshToken[]
  ownedLeads             Lead[]              @relation("LeadOwner")
  createdLeads           Lead[]              @relation("LeadCreator")
  notifications          Notification[]
  createdPurchaseOrders  PurchaseOrder[]     @relation("POCreatedBy")
  approvedPurchaseOrders PurchaseOrder[]     @relation("POApprovedBy")
  createdSalesOrders     SalesOrder[]        @relation("SalesOrderCreatedBy")
  approvedSalesOrders    SalesOrder[]        @relation("SalesOrderApprovedBy")
  createdVendorBills     VendorBill[]        @relation("BillCreatedBy")
  approvedVendorBills    VendorBill[]        @relation("BillApprovedBy")
  vendorBillPayments     VendorBillPayment[]
  managedProjects        Project[]           @relation("ProjectManager")
  createdProjects        Project[]           @relation("ProjectCreatedBy")
  projectMemberships     ProjectMember[]
  savedViews             SavedView[]
  apiKeys                ApiKey[]            @relation("ApiKeyUser")
  createdApiKeys         ApiKey[]            @relation("ApiKeyCreatedBy")

  // `updatedBy` back-relations — last user to edit each record (auto-stamped).
  updatedCustomers      Customer[]      @relation("CustomerUpdatedBy")
  updatedDeals          Deal[]          @relation("DealUpdatedBy")
  updatedLeads          Lead[]          @relation("LeadUpdatedBy")
  updatedProducts       Product[]       @relation("ProductUpdatedBy")
  updatedQuotes         Quote[]         @relation("QuoteUpdatedBy")
  updatedInvoices       Invoice[]       @relation("InvoiceUpdatedBy")
  updatedSalesOrders    SalesOrder[]    @relation("SalesOrderUpdatedBy")
  updatedExpenses       ExpenseReport[] @relation("ExpenseUpdatedBy")
  updatedActivities     Activity[]      @relation("ActivityUpdatedBy")
  updatedTasks          Task[]          @relation("TaskUpdatedBy")
  updatedSuppliers      Supplier[]      @relation("SupplierUpdatedBy")
  updatedPurchaseOrders PurchaseOrder[] @relation("POUpdatedBy")
  updatedVendorBills    VendorBill[]    @relation("BillUpdatedBy")
  updatedProjects       Project[]       @relation("ProjectUpdatedBy")
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Customer {
  id                     String    @id @default(cuid())
  name                   String
  phone                  String    @unique
  mobile                 String?
  email                  String?   @unique
  company                String?
  jobTitle               String?
  website                String?
  // Embedded objects stored as JSON
  address                Json?
  identification         Json?
  dateOfBirth            DateTime?
  gender                 String?
  preferredContactMethod String?
  paymentInformation     Json?
  loyaltyProgram         Json?
  emergencyContact       Json?
  location               String?
  ownerId                String?
  owner                  User?     @relation("CustomerOwner", fields: [ownerId], references: [id])
  updatedById            String?
  updatedBy              User?     @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  source                 String?
  status                 String?
  notes                  String?
  customFields           Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  deals         Deal[]
  quotes        Quote[]
  invoices      Invoice[]
  salesOrders   SalesOrder[]
  activities    Activity[]
  customerNotes Note[]
  timelines     TimelineEvent[]
  fromLead      Lead?           @relation("LeadConversion")
  projects      Project[]

  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model Deal {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  ownerId           String?
  owner             User?     @relation("DealOwner", fields: [ownerId], references: [id])
  updatedById       String?
  updatedBy         User?     @relation("DealUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  title             String
  category          String?
  dealType          String?
  price             Decimal   @db.Decimal(18, 4)
  currency          String    @default("EGP")
  status            String    @default("lead")
  priority          String?   @default("medium")
  probability       Float?    @default(10)
  source            String?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  quotes      Quote[]
  invoices    Invoice[]
  salesOrders SalesOrder[]
  activities  Activity[]
  dealNotes   Note[]
  timelines   TimelineEvent[]
  tasks       Task[]
  project     Project?

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model Lead {
  id                String    @id @default(cuid())
  name              String
  company           String?
  jobTitle          String?
  phone             String?
  email             String?
  mobile            String?
  website           String?
  city              String?
  country           String?
  source            String?
  campaign          String?
  status            String    @default("new")
  rating            String?
  budget            Float?
  currency          String?   @default("EGP")
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  customFields      Json?
  ownerId           String?
  owner             User?     @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById       String?
  createdBy         User?     @relation("LeadCreator", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         User?     @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  convertedToId     String?   @unique
  convertedTo       Customer? @relation("LeadConversion", fields: [convertedToId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([ownerId])
  @@index([status])
  @@index([rating])
  @@index([deletedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Product {
  id           String    @id @default(cuid())
  name         String
  type         String?
  capacity     Float?
  location     String?
  description  String?
  notes        String?
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  updatedById    String?
  updatedBy      User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  productNotes   Note[]
  stockItem      StockItem?
  stockMovements StockMovement[]
}

// Current on-hand stock per product (one row per product).
model StockItem {
  id             String   @id @default(cuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand Float    @default(0)
  reorderLevel   Float    @default(0)
  location       String?
  updatedAt      DateTime @updatedAt
}

// Append-only ledger of stock changes (audit trail). `qty` is signed:
// positive = stock in (e.g. PO receipt), negative = stock out (e.g. sale).
model StockMovement {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty              Float
  type             String // in | out | adjustment
  refType          String?
  refId            String?
  note             String?
  adjustmentReason String? // recount | damage | theft | expiry | write_off | return | correction
  createdById      String?
  createdAt        DateTime @default(now())

  @@index([productId, createdAt])
}

// ─── Finance — Quotes ────────────────────────────────────────────────────────

model Quote {
  id                   String         @id @default(cuid())
  quoteNumber          String         @unique
  title                String
  customerId           String
  customer             Customer       @relation(fields: [customerId], references: [id])
  dealId               String?
  deal                 Deal?          @relation(fields: [dealId], references: [id])
  status               String         @default("draft")
  subtotal             Decimal        @default(0) @db.Decimal(18, 4)
  taxRate              Float          @default(0)
  tax                  Decimal        @default(0) @db.Decimal(18, 4)
  total                Decimal        @default(0) @db.Decimal(18, 4)
  currency             String         @default("EGP")
  validUntil           DateTime?
  notes                String?
  terms                String?
  customFields         Json?
  convertedToInvoiceId String?        @unique
  convertedToInvoice   Invoice?       @relation("QuoteToInvoice", fields: [convertedToInvoiceId], references: [id])
  salesOrder           SalesOrder?    @relation("QuoteToSalesOrder")
  createdById          String
  createdBy            User           @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  approvalStatus       ApprovalStatus @default(pending)
  approvedById         String?
  approvedBy           User?          @relation("QuoteApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?          @relation("QuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  items QuoteLineItem[]

  @@index([customerId])
  @@index([dealId])
  @@index([status])
  @@index([deletedAt])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Float
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  taxCode     String?
  total       Decimal @db.Decimal(18, 4)
  order       Int     @default(0)
}

// ─── Finance — Invoices ──────────────────────────────────────────────────────

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  title           String
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation("SalesOrderToInvoice", fields: [salesOrderId], references: [id], onDelete: SetNull)
  fromQuote       Quote?         @relation("QuoteToInvoice")
  status          String         @default("draft")
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  totalPaid       Decimal        @default(0) @db.Decimal(18, 4)
  currency        String         @default("EGP")
  exchangeRate    Float?
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  createdById     String
  createdBy       User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    InvoiceLineItem[]
  payments InvoicePayment[]

  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Float
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  taxCode     String?
  total       Decimal @db.Decimal(18, 4)
  order       Int     @default(0)
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(18, 4)
  currency    String   @default("EGP")
  date        DateTime
  method      String   @default("cash")
  reference   String?
  notes       String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@index([accountId])
  @@index([date])
}

// ─── Sales Orders ─────────────────────────────────────────────────────────────
// A confirmed customer order between an accepted Quote and an Invoice. Mirrors
// the Quote/Invoice shape; the generated Invoice (not the SO) moves stock.

model SalesOrder {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  title           String
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fromQuoteId     String?        @unique
  fromQuote       Quote?         @relation("QuoteToSalesOrder", fields: [fromQuoteId], references: [id])
  status          String         @default("draft")
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  currency        String         @default("EGP")
  expectedDate    DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  createdById     String
  createdBy       User           @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("SalesOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("SalesOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    SalesOrderLineItem[]
  invoices Invoice[]            @relation("SalesOrderToInvoice")

  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model SalesOrderLineItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?
  description  String
  quantity     Float
  unitPrice    Decimal    @db.Decimal(18, 4)
  discount     Float      @default(0)
  taxRate      Float      @default(0)
  taxCode      String?
  total        Decimal    @db.Decimal(18, 4)
  order        Int        @default(0)
}

// ─── Accounts ─────────────────────────────────────────────────────────────────

model Account {
  id                 String              @id @default(cuid())
  name               String
  type               String              @default("cash")
  currency           String              @default("EGP")
  balance            Decimal             @default(0) @db.Decimal(18, 4)
  notes              String?
  invoicePayments    InvoicePayment[]
  vendorBillPayments VendorBillPayment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model ExpenseReport {
  id              String         @id @default(cuid())
  title           String
  userId          String
  user            User           @relation("ExpenseUser", fields: [userId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  customFields    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  expenses     ExpenseItem[]
  expenseNotes Note[]

  @@index([userId])
  @@index([projectId])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model ExpenseItem {
  id              String        @id @default(cuid())
  expenseReportId String
  expenseReport   ExpenseReport @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  description     String
  amount          Decimal       @db.Decimal(18, 4)
  date            DateTime
  category        String
  beneficiary     String
}

// ─── Activities & Notes ──────────────────────────────────────────────────────

model Activity {
  id           String    @id @default(cuid())
  type         String
  title        String
  description  String?
  date         DateTime
  status       String    @default("pending")
  // Polymorphic link — keep both generic fields and typed FKs
  linkedToId   String
  linkedModel  String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  dealId       String?
  deal         Deal?     @relation(fields: [dealId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation("ActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  customFields Json?
  createdById  String
  createdBy    User      @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?     @relation("ActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([assignedToId])
}

model Note {
  id              String         @id @default(cuid())
  content         String
  linkedToId      String
  linkedModel     String
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  expenseReportId String?
  expenseReport   ExpenseReport? @relation(fields: [expenseReportId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id           String            @id @default(cuid())
  title        String
  description  String?
  priority     String            @default("medium")
  status       String            @default("todo")
  dueDate      DateTime?
  assignedToId String?
  assignedTo   User?             @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  linkedToId   String?
  linkedModel  String?
  dealId       String?
  deal         Deal?             @relation(fields: [dealId], references: [id])
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId  String?
  milestone    ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  tags         String[]
  customFields Json?
  createdById  String
  createdBy    User              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?             @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([assignedToId])
  @@index([status])
  @@index([projectId])
  @@index([milestoneId])
  @@index([linkedToId, linkedModel])
  @@index([deletedAt])
}

// ─── Timeline ────────────────────────────────────────────────────────────────

model TimelineEvent {
  id            String    @id @default(cuid())
  eventType     String
  title         String
  payload       Json?
  linkedToId    String
  linkedModel   String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  dealId        String?
  deal          Deal?     @relation(fields: [dealId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  triggeredById String?
  triggeredBy   User?     @relation(fields: [triggeredById], references: [id])
  isSystem      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
}

// ─── System ──────────────────────────────────────────────────────────────────

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  method     String
  endpoint   String
  recordId   String?
  recordName String?
  success    Boolean  @default(true)
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([timestamp])
}

// Rotating refresh tokens. Only the SHA-256 hash of the opaque token is
// stored, never the token itself. Rotation revokes the old row and issues a
// new one; logout / deactivation revoke without deleting (audit trail).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
}

model NumberSequence {
  id         String @id @default(cuid())
  key        String @unique
  prefix     String @default("")
  lastNumber Int    @default(0)
  padLength  Int    @default(4)
  separator  String @default("-")
}

// Polymorphic file attachment (receipts, contracts, generated PDFs, …) linked
// to any entity via linkedModel + linkedToId, mirroring the Note/Activity pattern.
model Attachment {
  id           String   @id @default(cuid())
  filename     String
  storageKey   String
  mimeType     String
  size         Int
  linkedModel  String
  linkedToId   String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([linkedModel, linkedToId])
}

// One step in an entity's approval chain. Steps are generated from the module's
// approval config when the entity is submitted; the entity is fully approved
// only once every step is approved, and rejected if any step is rejected.
model ApprovalStep {
  id            String    @id @default(cuid())
  entityType    String // Invoice | Quote | ExpenseReport | PurchaseOrder | VendorBill
  entityId      String
  sequence      Int
  approverRoles String[]
  status        String    @default("pending") // pending | approved | rejected
  actedById     String?
  actedAt       DateTime?
  comment       String?
  createdAt     DateTime  @default(now())

  @@index([entityType, entityId])
}

model WorkspaceConfig {
  id              String   @id @default(cuid())
  approvals       Json     @default("[]")
  fieldGroups     Json     @default("[]")
  moduleSettings  Json     @default("[]")
  pipelineStages  Json     @default("[]")
  invoiceDefaults Json     @default("{}")
  passwordPolicy  Json     @default("{}")
  // Non-secret AI settings: { provider, model, enabled }. Keys live in AiKey.
  aiConfig        Json     @default("{}")
  baseCurrency    String   @default("EGP")
  locale          String   @default("en-US")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// An outbound email with open/click tracking. The body is rendered with a 1x1
// tracking pixel and rewritten links; delivery itself reuses EmailOutbox.
model TrackedEmail {
  id          String    @id @default(cuid())
  to          String
  subject     String
  // Polymorphic link to the record the email is about (Customer/Deal/Lead).
  linkedToId  String?
  linkedModel String?
  status      String    @default("queued") // queued | sent | failed
  openCount   Int       @default(0)
  openedAt    DateTime?
  clickCount  Int       @default(0)
  clickedAt   DateTime?
  outboxId    String?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([linkedToId, linkedModel])
  @@index([createdById])
}

// Encrypted AI provider API keys. scope=workspace (userId null) is the default;
// scope=user is a per-user override. Only the encrypted key is stored.
model AiKey {
  id        String   @id @default(cuid())
  provider  String // anthropic | google | openai
  scope     String // workspace | user
  userId    String?
  encKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, provider])
  @@index([userId])
}

// Per-user saved list views: a named snapshot of a list page's query string
// (search + filters + sort), surfaced as quick presets on that module's list.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String // e.g. customers | leads | deals
  name      String
  query     String // serialized URLSearchParams (q, filters, sort, dir)
  createdAt DateTime @default(now())

  @@index([userId, module])
}

// Public API keys. Only the SHA-256 hash is stored; the raw key is shown once on
// creation. A key acts as `user` and inherits that user's role permissions, so
// the existing PermissionGuard/visibility rules apply unchanged.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String // leading chars, shown in the UI to identify the key
  keyHash     String    @unique
  userId      String
  user        User      @relation("ApiKeyUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model TaxRate {
  id        String   @id @default(cuid())
  name      String
  rate      Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmtpConfig {
  id        String   @id @default(cuid())
  host      String
  port      Int      @default(587)
  user      String
  encPass   String
  fromName  String?
  fromEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Durable email queue. Notification emails are enqueued here and delivered by
// the scheduler with retry/backoff, so a transient SMTP failure is retried
// instead of silently dropped.
model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  html      String
  status    String    @default("pending") // pending | sent | failed
  attempts  Int       @default(0)
  lastError String?
  sendAfter DateTime  @default(now())
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, sendAfter])
}

// Manual exchange rates used to consolidate multi-currency figures to the
// workspace base currency. `rate` = value of 1 unit of `currency` expressed in
// `baseCurrency`. The latest row (by asOf) per currency is authoritative.
model ExchangeRate {
  id           String   @id @default(cuid())
  currency     String
  baseCurrency String
  rate         Float
  asOf         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([currency, asOf])
}

// ─── Procurement — Suppliers ──────────────────────────────────────────────────

model Supplier {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String?
  address      Json?
  taxId        String?
  currency     String    @default("EGP")
  notes        String?
  status       String    @default("active")
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  updatedById    String?
  updatedBy      User?           @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]

  @@index([status])
  @@index([deletedAt])
}

// ─── Procurement — Purchase Orders ───────────────────────────────────────────

model PurchaseOrder {
  id              String         @id @default(cuid())
  poNumber        String         @unique
  title           String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  status          String         @default("draft")
  currency        String         @default("EGP")
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  expectedDate    DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("POUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User           @relation("POCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items PurchaseOrderItem[]
  bills VendorBill[]

  @@index([supplierId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  description     String
  quantity        Float
  unitPrice       Decimal       @db.Decimal(18, 4)
  discount        Float         @default(0)
  taxRate         Float         @default(0)
  taxCode         String?
  total           Decimal       @db.Decimal(18, 4)
  order           Int           @default(0)
}

// ─── Procurement — Vendor Bills ───────────────────────────────────────────────

model VendorBill {
  id              String         @id @default(cuid())
  billNumber      String         @unique
  title           String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  status          String         @default("draft")
  currency        String         @default("EGP")
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  totalPaid       Decimal        @default(0) @db.Decimal(18, 4)
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("BillApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("BillUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User           @relation("BillCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    VendorBillItem[]
  payments VendorBillPayment[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model VendorBillItem {
  id          String     @id @default(cuid())
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Float
  unitPrice   Decimal    @db.Decimal(18, 4)
  discount    Float      @default(0)
  taxRate     Float      @default(0)
  taxCode     String?
  total       Decimal    @db.Decimal(18, 4)
  order       Int        @default(0)
}

model VendorBillPayment {
  id          String     @id @default(cuid())
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Decimal    @db.Decimal(18, 4)
  currency    String     @default("EGP")
  date        DateTime
  method      String     @default("cash")
  reference   String?
  notes       String?
  accountId   String?
  account     Account?   @relation(fields: [accountId], references: [id])
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([billId])
  @@index([accountId])
  @@index([date])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id           String    @id @default(cuid())
  name         String
  description  String?
  status       String    @default("planning")
  priority     String    @default("medium")
  budget       Float?
  currency     String    @default("EGP")
  startDate    DateTime?
  endDate      DateTime?
  completedAt  DateTime?
  customFields Json?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  dealId       String?   @unique
  deal         Deal?     @relation(fields: [dealId], references: [id])
  managerId    String?
  manager      User?     @relation("ProjectManager", fields: [managerId], references: [id])
  createdById  String
  createdBy    User      @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?     @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  milestones  ProjectMilestone[]
  members     ProjectMember[]
  tasks       Task[]
  invoices    Invoice[]
  salesOrders SalesOrder[]
  expenses    ExpenseReport[]
  activities  Activity[]
  notes       Note[]
  timelines   TimelineEvent[]

  @@index([customerId])
  @@index([status])
  @@index([managerId])
  @@index([deletedAt])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("pending")
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([projectId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}
