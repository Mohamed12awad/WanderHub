generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Schema conventions ───────────────────────────────────────────────────────
//
// Aggregate-root models (Customer, Deal, Lead, Invoice, Quote, ExpenseReport,
// PurchaseOrder, VendorBill, Project, Task, …) carry:
//   createdAt  DateTime  @default(now())
//   updatedAt  DateTime  @updatedAt
//   deletedAt  DateTime? — soft-delete; all services filter `deletedAt: null`
//
// Child / line-item models (*LineItem, ProjectMember, InvoicePayment, …) carry
// only what they need; omitting updatedAt/deletedAt is intentional.
//
// ─── Enums ───────────────────────────────────────────────────────────────────

// Dropdown values that were previously Prisma enums (status / priority / type /
// rating / account-type) are now plain String columns. Their options are
// user-configurable at /settings/fields, so the DB no longer constrains them.

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  task_assigned
  deal_assigned
  lead_assigned
  approval_requested
  approval_approved
  approval_rejected
  invoice_overdue
  bill_overdue
}

// Distinguishes a person from an organisation on a Customer record. The DB keeps
// the type-specific columns (firstName/lastName vs companyName/taxId) nullable;
// the NestJS DTO layer enforces which are required based on the selected `type`.
enum ContactType {
  individual
  company
}

// ─── Auth & Config ────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id                      String   @id @default(cuid())
  name                    String
  email                   String   @unique
  phone                   String
  password                String
  active                  Boolean  @default(true)
  notificationPreferences Json?
  defaultLandingPage      String?
  hasOnboarded            Boolean  @default(false)
  roleId                  String
  role                    Role     @relation(fields: [roleId], references: [id])
  reportsToId             String?
  reportsTo               User?    @relation("ReportsTo", fields: [reportsToId], references: [id])
  directReports           User[]   @relation("ReportsTo")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  ownedCustomers         Customer[]          @relation("CustomerOwner")
  ownedDeals             Deal[]              @relation("DealOwner")
  createdQuotes          Quote[]             @relation("QuoteCreatedBy")
  approvedQuotes         Quote[]             @relation("QuoteApprovedBy")
  createdInvoices        Invoice[]           @relation("InvoiceCreatedBy")
  approvedInvoices       Invoice[]           @relation("InvoiceApprovedBy")
  invoicePayments        InvoicePayment[]
  expenseReports         ExpenseReport[]     @relation("ExpenseUser")
  approvedExpenses       ExpenseReport[]     @relation("ExpenseApprovedBy")
  assignedActivities     Activity[]          @relation("ActivityAssignedTo")
  createdActivities      Activity[]          @relation("ActivityCreatedBy")
  notes                  Note[]
  assignedTasks          Task[]              @relation("TaskAssignedTo")
  createdTasks           Task[]              @relation("TaskCreatedBy")
  triggeredTimelines     TimelineEvent[]
  logs                   Log[]
  refreshTokens          RefreshToken[]
  ownedLeads             Lead[]              @relation("LeadOwner")
  createdLeads           Lead[]              @relation("LeadCreator")
  notifications          Notification[]
  createdPurchaseOrders  PurchaseOrder[]     @relation("POCreatedBy")
  approvedPurchaseOrders PurchaseOrder[]     @relation("POApprovedBy")
  createdSalesOrders     SalesOrder[]        @relation("SalesOrderCreatedBy")
  approvedSalesOrders    SalesOrder[]        @relation("SalesOrderApprovedBy")
  createdVendorBills     VendorBill[]        @relation("BillCreatedBy")
  approvedVendorBills    VendorBill[]        @relation("BillApprovedBy")
  closedPeriods          AccountingPeriod[]  @relation("PeriodClosedBy")
  vendorBillPayments     VendorBillPayment[]
  managedProjects        Project[]           @relation("ProjectManager")
  createdProjects        Project[]           @relation("ProjectCreatedBy")
  projectMemberships     ProjectMember[]
  savedViews             SavedView[]
  apiKeys                ApiKey[]            @relation("ApiKeyUser")
  createdApiKeys         ApiKey[]            @relation("ApiKeyCreatedBy")
  journalEntries         JournalEntry[]      @relation("JournalCreatedBy")

  // `updatedBy` back-relations — last user to edit each record (auto-stamped).
  updatedCustomers      Customer[]      @relation("CustomerUpdatedBy")
  updatedDeals          Deal[]          @relation("DealUpdatedBy")
  updatedLeads          Lead[]          @relation("LeadUpdatedBy")
  updatedProducts       Product[]       @relation("ProductUpdatedBy")
  updatedQuotes         Quote[]         @relation("QuoteUpdatedBy")
  updatedInvoices       Invoice[]       @relation("InvoiceUpdatedBy")
  updatedSalesOrders    SalesOrder[]    @relation("SalesOrderUpdatedBy")
  updatedExpenses       ExpenseReport[] @relation("ExpenseUpdatedBy")
  updatedActivities     Activity[]      @relation("ActivityUpdatedBy")
  updatedTasks          Task[]          @relation("TaskUpdatedBy")
  updatedSuppliers      Supplier[]      @relation("SupplierUpdatedBy")
  updatedPurchaseOrders PurchaseOrder[] @relation("POUpdatedBy")
  updatedVendorBills    VendorBill[]    @relation("BillUpdatedBy")
  updatedProjects       Project[]       @relation("ProjectUpdatedBy")
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Customer {
  id                     String      @id @default(cuid())
  // Individual vs company. Type-specific fields below are nullable in the DB and
  // validated by `type` in the customer DTO (the single source of required-by-type
  // rules). `name` remains the canonical display name (derived from first/last name
  // for individuals, or companyName for companies).
  type                   ContactType @default(individual)
  name                   String
  // Individual-only (required-by-type in DTO)
  firstName              String?
  lastName               String?
  phone                  String      @unique
  mobile                 String?
  email                  String?     @unique
  // `companyName` supersedes the legacy `company` string for company-type contacts;
  // `company` is retained for back-compat until callers migrate.
  companyName            String?
  taxId                  String?
  company                String?
  jobTitle               String?
  website                String?
  // Embedded objects stored as JSON
  address                Json?
  identification         Json?
  dateOfBirth            DateTime?
  gender                 String?
  preferredContactMethod String?
  paymentInformation     Json?
  loyaltyProgram         Json?
  emergencyContact       Json?
  location               String?
  ownerId                String?
  owner                  User?       @relation("CustomerOwner", fields: [ownerId], references: [id])
  updatedById            String?
  updatedBy              User?       @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  source                 String?
  status                 String?
  notes                  String?
  customFields           Json?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?

  deals         Deal[]
  quotes        Quote[]
  invoices      Invoice[]
  salesOrders   SalesOrder[]
  activities    Activity[]
  customerNotes Note[]
  timelines     TimelineEvent[]
  fromLead      Lead?           @relation("LeadConversion")
  projects      Project[]

  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model Deal {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  ownerId           String?
  owner             User?     @relation("DealOwner", fields: [ownerId], references: [id])
  updatedById       String?
  updatedBy         User?     @relation("DealUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  title             String
  category          String?
  dealType          String?
  price             Decimal   @db.Decimal(18, 4)
  currency          String    @default("EGP")
  status            String    @default("lead")
  priority          String?   @default("medium")
  probability       Float?    @default(10)
  source            String?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  quotes      Quote[]
  invoices    Invoice[]
  salesOrders SalesOrder[]
  activities  Activity[]
  dealNotes   Note[]
  timelines   TimelineEvent[]
  tasks       Task[]
  project     Project?

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model Lead {
  id                String    @id @default(cuid())
  name              String
  company           String?
  jobTitle          String?
  phone             String?
  email             String?
  mobile            String?
  website           String?
  city              String?
  country           String?
  source            String?
  campaign          String?
  status            String    @default("new")
  rating            String?
  budget            Float?
  currency          String?   @default("EGP")
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  customFields      Json?
  ownerId           String?
  owner             User?     @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById       String?
  createdBy         User?     @relation("LeadCreator", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         User?     @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  convertedToId     String?   @unique
  convertedTo       Customer? @relation("LeadConversion", fields: [convertedToId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([ownerId])
  @@index([status])
  @@index([rating])
  @@index([deletedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

// Product category. `costMethod` (nullable) sets the inventory cost-flow policy
// for its products, overriding the org default in glConfig.
model ProductCategory {
  id         String            @id @default(cuid())
  name       String
  code       String?           @unique
  costMethod String? // weighted_average | fifo | null = inherit org default
  parentId   String?
  parent     ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   ProductCategory[] @relation("CategoryTree")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  products Product[]

  @@index([deletedAt])
}

model Product {
  id              String           @id @default(cuid())
  name            String
  type            String?
  capacity        Float?
  location        String?
  description     String?
  notes           String?
  customFields    Json?
  // Service-type products (false) are skipped by the inventory/costing hooks.
  tracksInventory Boolean          @default(true)
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  updatedById    String?
  updatedBy      User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  productNotes   Note[]
  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
}

// A physical stock location. Stock is held per (product, warehouse).
model Warehouse {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  address   Json?
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@index([isDefault])
  @@index([deletedAt])
}

// Current on-hand stock per (product, warehouse). `avgCost`/`totalValue` carry
// the perpetual weighted-average valuation (maintained under a row lock).
model StockItem {
  id             String     @id @default(cuid())
  productId      String
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId    String?
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])
  quantityOnHand Float      @default(0)
  reorderLevel   Float      @default(0)
  avgCost        Decimal    @default(0) @db.Decimal(18, 4)
  totalValue     Decimal    @default(0) @db.Decimal(18, 4)
  location       String?
  updatedAt      DateTime   @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

// Append-only ledger of stock changes (audit trail). `qty` is signed:
// positive = stock in (e.g. PO receipt), negative = stock out (e.g. sale).
model StockMovement {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId      String?
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])
  qty              Float
  type             String // in | out | adjustment | transfer
  unitCost         Decimal?        @db.Decimal(18, 4) // per-unit cost (purchase cost inbound; COGS cost outbound)
  costMethod       String? // snapshot of the method applied (weighted_average | fifo)
  // Links a return/reversal to the originating move so it restores at the
  // original cost rather than the current average.
  sourceMovementId String?
  sourceMovement   StockMovement?  @relation("MovementSource", fields: [sourceMovementId], references: [id])
  reversals        StockMovement[] @relation("MovementSource")
  refType          String?
  refId            String?
  note             String?
  adjustmentReason String? // recount | damage | theft | expiry | write_off | return | correction
  createdById      String?
  createdAt        DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId])
}

// FIFO cost layers: each inbound receipt creates a layer; outbound moves consume
// the oldest layers first. Only used when a product's cost method is `fifo`.
model StockCostLayer {
  id               String   @id @default(cuid())
  productId        String
  warehouseId      String?
  remainingQty     Float
  originalQty      Float
  unitCost         Decimal  @db.Decimal(18, 4)
  receivedAt       DateTime @default(now())
  sourceMovementId String?
  createdAt        DateTime @default(now())

  @@index([productId, warehouseId, receivedAt])
}

// ─── Finance — Quotes ────────────────────────────────────────────────────────

model Quote {
  id                   String         @id @default(cuid())
  quoteNumber          String         @unique
  title                String
  customerId           String
  customer             Customer       @relation(fields: [customerId], references: [id])
  dealId               String?
  deal                 Deal?          @relation(fields: [dealId], references: [id])
  status               String         @default("draft")
  subtotal             Decimal        @default(0) @db.Decimal(18, 4)
  taxRate              Float          @default(0)
  tax                  Decimal        @default(0) @db.Decimal(18, 4)
  total                Decimal        @default(0) @db.Decimal(18, 4)
  currency             String         @default("EGP")
  validUntil           DateTime?
  notes                String?
  terms                String?
  customFields         Json?
  convertedToInvoiceId String?        @unique
  convertedToInvoice   Invoice?       @relation("QuoteToInvoice", fields: [convertedToInvoiceId], references: [id])
  salesOrder           SalesOrder?    @relation("QuoteToSalesOrder")
  createdById          String
  createdBy            User           @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  approvalStatus       ApprovalStatus @default(pending)
  approvedById         String?
  approvedBy           User?          @relation("QuoteApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?          @relation("QuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  items QuoteLineItem[]

  @@index([customerId])
  @@index([dealId])
  @@index([status])
  @@index([deletedAt])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Float
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  taxCode     String?
  total       Decimal @db.Decimal(18, 4)
  order       Int     @default(0)
}

// ─── Finance — Invoices ──────────────────────────────────────────────────────

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  title           String
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation("SalesOrderToInvoice", fields: [salesOrderId], references: [id], onDelete: SetNull)
  fromQuote       Quote?         @relation("QuoteToInvoice")
  status          String         @default("draft")
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  // When true, line `unitPrice`s already include tax (tax is back-calculated out
  // of the subtotal); when false, tax is added on top. Default seeded from
  // WorkspaceConfig.invoiceDefaults.taxInclusive. See finance.math.ts.
  taxInclusive    Boolean        @default(false)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  totalPaid       Decimal        @default(0) @db.Decimal(18, 4)
  currency        String         @default("EGP")
  exchangeRate    Float?
  // Analytic cost center (optional). Detached, not deleted, if the cost center is removed.
  costCenterId    String?
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  createdById     String
  createdBy       User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    InvoiceLineItem[]
  payments InvoicePayment[]

  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([costCenterId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Float
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  taxCode     String?
  total       Decimal @db.Decimal(18, 4)
  order       Int     @default(0)
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(18, 4)
  currency    String   @default("EGP")
  date        DateTime
  method      String   @default("cash")
  reference   String?
  notes       String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@index([accountId])
  @@index([date])
}

// ─── Sales Orders ─────────────────────────────────────────────────────────────
// A confirmed customer order between an accepted Quote and an Invoice. Mirrors
// the Quote/Invoice shape; the generated Invoice (not the SO) moves stock.

model SalesOrder {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  title           String
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fromQuoteId     String?        @unique
  fromQuote       Quote?         @relation("QuoteToSalesOrder", fields: [fromQuoteId], references: [id])
  status          String         @default("draft")
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  currency        String         @default("EGP")
  expectedDate    DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  createdById     String
  createdBy       User           @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("SalesOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("SalesOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    SalesOrderLineItem[]
  invoices Invoice[]            @relation("SalesOrderToInvoice")

  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model SalesOrderLineItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?
  description  String
  quantity     Float
  unitPrice    Decimal    @db.Decimal(18, 4)
  discount     Float      @default(0)
  taxRate      Float      @default(0)
  taxCode      String?
  total        Decimal    @db.Decimal(18, 4)
  order        Int        @default(0)
}

// ─── Accounts ─────────────────────────────────────────────────────────────────

model Account {
  id                 String              @id @default(cuid())
  name               String
  type               String              @default("cash")
  currency           String              @default("EGP")
  balance            Decimal             @default(0) @db.Decimal(18, 4)
  notes              String?
  invoicePayments    InvoicePayment[]
  vendorBillPayments VendorBillPayment[]
  chartOfAccount     ChartOfAccount?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model ExpenseReport {
  id              String         @id @default(cuid())
  title           String
  userId          String
  user            User           @relation("ExpenseUser", fields: [userId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  customFields    Json?
  // Analytic cost center (optional). Detached, not deleted, if the cost center is removed.
  costCenterId    String?
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  expenses     ExpenseItem[]
  expenseNotes Note[]

  @@index([userId])
  @@index([projectId])
  @@index([costCenterId])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model ExpenseItem {
  id              String            @id @default(cuid())
  expenseReportId String
  expenseReport   ExpenseReport     @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  description     String
  amount          Decimal           @db.Decimal(18, 4)
  date            DateTime
  category        String
  beneficiary     String
  // Optional cost attribution to a task / milestone. These are the roll-up source
  // for the *computed* actualCost on Task/ProjectMilestone (never stored there).
  taskId          String?
  task            Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([milestoneId])
}

// ─── Activities & Notes ──────────────────────────────────────────────────────

model Activity {
  id           String    @id @default(cuid())
  type         String
  title        String
  description  String?
  date         DateTime
  status       String    @default("pending")
  // Polymorphic link — keep both generic fields and typed FKs
  linkedToId   String
  linkedModel  String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  dealId       String?
  deal         Deal?     @relation(fields: [dealId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation("ActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  customFields Json?
  createdById  String
  createdBy    User      @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?     @relation("ActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([assignedToId])
}

model Note {
  id              String         @id @default(cuid())
  content         String
  linkedToId      String
  linkedModel     String
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  dealId          String?
  deal            Deal?          @relation(fields: [dealId], references: [id])
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  expenseReportId String?
  expenseReport   ExpenseReport? @relation(fields: [expenseReportId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id            String            @id @default(cuid())
  title         String
  description   String?
  priority      String            @default("medium")
  status        String            @default("todo")
  dueDate       DateTime?
  assignedToId  String?
  assignedTo    User?             @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  linkedToId    String?
  linkedModel   String?
  dealId        String?
  deal          Deal?             @relation(fields: [dealId], references: [id])
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId   String?
  milestone     ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  tags          String[]
  // Planning figure only. `actualCost` is NOT stored — it is computed at the
  // service layer by summing attributed ExpenseItem amounts (see expenseItems).
  estimatedCost Decimal?          @db.Decimal(18, 4)
  customFields  Json?
  createdById   String
  createdBy     User              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?             @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  expenseItems ExpenseItem[]

  @@index([assignedToId])
  @@index([status])
  @@index([projectId])
  @@index([milestoneId])
  @@index([linkedToId, linkedModel])
  @@index([deletedAt])
}

// ─── Timeline ────────────────────────────────────────────────────────────────

model TimelineEvent {
  id            String    @id @default(cuid())
  eventType     String
  title         String
  payload       Json?
  linkedToId    String
  linkedModel   String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  dealId        String?
  deal          Deal?     @relation(fields: [dealId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  triggeredById String?
  triggeredBy   User?     @relation(fields: [triggeredById], references: [id])
  isSystem      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([linkedToId, linkedModel])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
}

// ─── System ──────────────────────────────────────────────────────────────────

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  method     String
  endpoint   String
  recordId   String?
  recordName String?
  success    Boolean  @default(true)
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([timestamp])
}

// Rotating refresh tokens. Only the SHA-256 hash of the opaque token is
// stored, never the token itself. Rotation revokes the old row and issues a
// new one; logout / deactivation revoke without deleting (audit trail).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
}

model NumberSequence {
  id         String @id @default(cuid())
  key        String @unique
  prefix     String @default("")
  lastNumber Int    @default(0)
  padLength  Int    @default(4)
  separator  String @default("-")
}

// Polymorphic file attachment (receipts, contracts, generated PDFs, …) linked
// to any entity via linkedModel + linkedToId, mirroring the Note/Activity pattern.
model Attachment {
  id           String   @id @default(cuid())
  filename     String
  storageKey   String
  mimeType     String
  size         Int
  linkedModel  String
  linkedToId   String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([linkedModel, linkedToId])
}

// One step in an entity's approval chain. Steps are generated from the module's
// approval config when the entity is submitted; the entity is fully approved
// only once every step is approved, and rejected if any step is rejected.
model ApprovalStep {
  id            String    @id @default(cuid())
  entityType    String // Invoice | Quote | ExpenseReport | PurchaseOrder | VendorBill
  entityId      String
  sequence      Int
  approverRoles String[]
  status        String    @default("pending") // pending | approved | rejected
  actedById     String?
  actedAt       DateTime?
  comment       String?
  createdAt     DateTime  @default(now())

  @@index([entityType, entityId])
}

model WorkspaceConfig {
  id              String   @id @default(cuid())
  approvals       Json     @default("[]")
  fieldGroups     Json     @default("[]")
  moduleSettings  Json     @default("[]")
  pipelineStages  Json     @default("[]")
  invoiceDefaults Json     @default("{}")
  passwordPolicy  Json     @default("{}")
  // Non-secret AI settings: { provider, model, enabled }. Keys live in AiKey.
  aiConfig        Json     @default("{}")
  // GL / accounting config: default account codes, defaultCostMethod, glEnabled,
  // glCutoverDate, defaultFxGainLossAccount, defaultTaxPayable. Resolved by PostingService.
  glConfig        Json     @default("{}")
  baseCurrency    String   @default("EGP")
  locale          String   @default("en-US")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// An outbound email with open/click tracking. The body is rendered with a 1x1
// tracking pixel and rewritten links; delivery itself reuses EmailOutbox.
model TrackedEmail {
  id          String    @id @default(cuid())
  to          String
  subject     String
  // Polymorphic link to the record the email is about (Customer/Deal/Lead).
  linkedToId  String?
  linkedModel String?
  status      String    @default("queued") // queued | sent | failed
  openCount   Int       @default(0)
  openedAt    DateTime?
  clickCount  Int       @default(0)
  clickedAt   DateTime?
  outboxId    String?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([linkedToId, linkedModel])
  @@index([createdById])
}

// Encrypted AI provider API keys. scope=workspace (userId null) is the default;
// scope=user is a per-user override. Only the encrypted key is stored.
model AiKey {
  id        String   @id @default(cuid())
  provider  String // anthropic | google | openai
  scope     String // workspace | user
  userId    String?
  encKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, provider])
  @@index([userId])
}

// Per-user saved list views: a named snapshot of a list page's query string
// (search + filters + sort), surfaced as quick presets on that module's list.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String // e.g. customers | leads | deals
  name      String
  query     String // serialized URLSearchParams (q, filters, sort, dir)
  createdAt DateTime @default(now())

  @@index([userId, module])
}

// Public API keys. Only the SHA-256 hash is stored; the raw key is shown once on
// creation. A key acts as `user` and inherits that user's role permissions, so
// the existing PermissionGuard/visibility rules apply unchanged.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String // leading chars, shown in the UI to identify the key
  keyHash     String    @unique
  userId      String
  user        User      @relation("ApiKeyUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model TaxRate {
  id                   String   @id @default(cuid())
  name                 String
  rate                 Float
  isDefault            Boolean  @default(false)
  // GL mapping: output/collected liability account (sales) and input/recoverable
  // account (purchases). Null falls back to glConfig.defaultTaxPayable.
  liabilityAccountCode String?
  inputAccountCode     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SmtpConfig {
  id        String   @id @default(cuid())
  host      String
  port      Int      @default(587)
  user      String
  encPass   String
  fromName  String?
  fromEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Durable email queue. Notification emails are enqueued here and delivered by
// the scheduler with retry/backoff, so a transient SMTP failure is retried
// instead of silently dropped.
model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  html      String
  status    String    @default("pending") // pending | sent | failed
  attempts  Int       @default(0)
  lastError String?
  sendAfter DateTime  @default(now())
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, sendAfter])
}

// Manual exchange rates used to consolidate multi-currency figures to the
// workspace base currency. `rate` = value of 1 unit of `currency` expressed in
// `baseCurrency`. The latest row (by asOf) per currency is authoritative.
model ExchangeRate {
  id           String   @id @default(cuid())
  currency     String
  baseCurrency String
  rate         Float
  asOf         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([currency, asOf])
}

// ─── Procurement — Suppliers ──────────────────────────────────────────────────

model Supplier {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String?
  address      Json?
  taxId        String?
  currency     String    @default("EGP")
  notes        String?
  status       String    @default("active")
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  updatedById    String?
  updatedBy      User?           @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]

  @@index([status])
  @@index([deletedAt])
}

// ─── Procurement — Purchase Orders ───────────────────────────────────────────

model PurchaseOrder {
  id              String         @id @default(cuid())
  poNumber        String         @unique
  title           String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  status          String         @default("draft")
  currency        String         @default("EGP")
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  expectedDate    DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("POUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User           @relation("POCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items PurchaseOrderItem[]
  bills VendorBill[]

  @@index([supplierId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  description     String
  quantity        Float
  unitPrice       Decimal       @db.Decimal(18, 4)
  discount        Float         @default(0)
  taxRate         Float         @default(0)
  taxCode         String?
  total           Decimal       @db.Decimal(18, 4)
  order           Int           @default(0)
}

// ─── Procurement — Vendor Bills ───────────────────────────────────────────────

model VendorBill {
  id              String         @id @default(cuid())
  billNumber      String         @unique
  title           String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  status          String         @default("draft")
  currency        String         @default("EGP")
  // Foreign→base rate captured at bill creation, so AP is booked and later
  // relieved at the historical rate (mirrors Invoice.exchangeRate). Without it,
  // payments would relieve AP at the current market rate and never clear.
  exchangeRate    Float?
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxRate         Float          @default(0)
  // Whether line prices already include tax (back-calculated). Mirrors Invoice. See finance.math.ts.
  taxInclusive    Boolean        @default(false)
  tax             Decimal        @default(0) @db.Decimal(18, 4)
  total           Decimal        @default(0) @db.Decimal(18, 4)
  totalPaid       Decimal        @default(0) @db.Decimal(18, 4)
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  terms           String?
  customFields    Json?
  // Analytic cost center (optional). Detached, not deleted, if the cost center is removed.
  costCenterId    String?
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  approvalStatus  ApprovalStatus @default(pending)
  approvedById    String?
  approvedBy      User?          @relation("BillApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?          @relation("BillUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User           @relation("BillCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  items    VendorBillItem[]
  payments VendorBillPayment[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([costCenterId])
  @@index([status])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model VendorBillItem {
  id          String     @id @default(cuid())
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Float
  unitPrice   Decimal    @db.Decimal(18, 4)
  discount    Float      @default(0)
  taxRate     Float      @default(0)
  taxCode     String?
  total       Decimal    @db.Decimal(18, 4)
  order       Int        @default(0)
}

model VendorBillPayment {
  id          String     @id @default(cuid())
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Decimal    @db.Decimal(18, 4)
  currency    String     @default("EGP")
  date        DateTime
  method      String     @default("cash")
  reference   String?
  notes       String?
  accountId   String?
  account     Account?   @relation(fields: [accountId], references: [id])
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([billId])
  @@index([accountId])
  @@index([date])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id           String    @id @default(cuid())
  name         String
  description  String?
  status       String    @default("planning")
  priority     String    @default("medium")
  budget       Float?
  currency     String    @default("EGP")
  startDate    DateTime?
  endDate      DateTime?
  completedAt  DateTime?
  customFields Json?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  dealId       String?   @unique
  deal         Deal?     @relation(fields: [dealId], references: [id])
  managerId    String?
  manager      User?     @relation("ProjectManager", fields: [managerId], references: [id])
  createdById  String
  createdBy    User      @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?     @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  milestones  ProjectMilestone[]
  members     ProjectMember[]
  tasks       Task[]
  invoices    Invoice[]
  salesOrders SalesOrder[]
  expenses    ExpenseReport[]
  activities  Activity[]
  notes       Note[]
  timelines   TimelineEvent[]

  @@index([customerId])
  @@index([status])
  @@index([managerId])
  @@index([deletedAt])
}

model ProjectMilestone {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        String    @default("pending")
  dueDate       DateTime?
  completedAt   DateTime?
  order         Int       @default(0)
  // Planning figure only. `actualCost` is NOT stored — it is computed at the
  // service layer by summing attributed ExpenseItem amounts (its own + its tasks').
  estimatedCost Decimal?  @db.Decimal(18, 4)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks        Task[]
  expenseItems ExpenseItem[]

  @@index([projectId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ─── Accounting — Double-Entry General Ledger ─────────────────────────────────
// The GL is the source of financial truth from glConfig.glCutoverDate onward.
// Operational fields (Invoice.totalPaid, Account.balance, StockItem.totalValue)
// become caches reconciled daily against these tables. See plans/Full_ERP_Plan.md.

enum AccountType {
  asset
  liability
  equity
  income
  expense
}

enum NormalBalance {
  debit
  credit
}

enum JournalStatus {
  draft
  posted
  reversed
}

// A General Ledger account (chart of accounts). Distinct from the cash/bank
// `Account` model: each cash Account maps to exactly one asset-type COA row.
model ChartOfAccount {
  id            String           @id @default(cuid())
  code          String           @unique // e.g. 1100
  name          String
  type          AccountType
  normalBalance NormalBalance
  parentId      String?
  parent        ChartOfAccount?  @relation("CoaHierarchy", fields: [parentId], references: [id])
  children      ChartOfAccount[] @relation("CoaHierarchy")
  isActive      Boolean          @default(true)
  currency      String           @default("EGP")
  cashAccountId String?          @unique
  cashAccount   Account?         @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  journalLines    JournalLine[]
  accountBalances AccountBalance[]

  @@index([type])
  @@index([parentId])
  @@index([deletedAt])
}

// A balanced journal entry. `@@unique([sourceType, sourceId])` enforces posting
// idempotency at the DB level. `sourceId` is the *specific posting event*
// (e.g. an InvoicePayment id), not the parent document — supports partial
// allocation. Corrections post a reversing mirror entry; lines are never mutated.
model JournalEntry {
  id              String        @id @default(cuid())
  entryNumber     String        @unique // via NumberSequenceService, prefix JE
  date            DateTime
  memo            String?
  sourceType      String // Manual | Invoice | InvoicePayment | VendorBill | VendorBillPayment | StockReceipt | ... | Reversal
  sourceId        String
  status          JournalStatus @default(posted)
  reversesEntryId String?       @unique
  reversesEntry   JournalEntry? @relation("JournalReversal", fields: [reversesEntryId], references: [id])
  reversedBy      JournalEntry? @relation("JournalReversal")
  createdById     String?
  createdBy       User?         @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines JournalLine[]

  @@unique([sourceType, sourceId])
  @@index([date, status])
  @@index([sourceType, sourceId])
}

// One debit or credit leg. `baseAmount` is the base-currency value (via
// CurrencyService.toBase) that all statements aggregate. Optional dimensions are
// scalar (not FK relations) so analytics can tag entries without coupling models.
model JournalLine {
  id             String         @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  debit          Decimal        @default(0) @db.Decimal(18, 4)
  credit         Decimal        @default(0) @db.Decimal(18, 4)
  currency       String         @default("EGP")
  baseAmount     Decimal        @default(0) @db.Decimal(18, 4)
  memo           String?
  // optional analytic dimensions (scalar, no referential integrity)
  customerId     String?
  supplierId     String?
  projectId      String?
  productId      String?
  warehouseId    String?
  // Cost center is modeled as a proper FK relation (unlike the legacy scalar dims
  // above) so GL analytics can be sliced by cost center with referential integrity.
  costCenterId   String?
  costCenter     CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([accountId])
  @@index([journalEntryId])
  @@index([costCenterId])
}

// Per-account, per-period balance snapshot for fast statements. Written only at
// period close; the current open period is computed live from prior close +
// open-period journal lines.
model AccountBalance {
  id             String         @id @default(cuid())
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  period         String // YYYY-MM
  openingBalance Decimal        @default(0) @db.Decimal(18, 4)
  periodDebit    Decimal        @default(0) @db.Decimal(18, 4)
  periodCredit   Decimal        @default(0) @db.Decimal(18, 4)
  closingBalance Decimal        @default(0) @db.Decimal(18, 4)
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([accountId, period])
  @@index([accountId, period])
}

// ─── Cost Centers (Analytic Accounts) ─────────────────────────────────────────
// A reportable analytic dimension attached to financial documents (Invoice,
// VendorBill, ExpenseReport) and propagated onto their GL postings (JournalLine).
// Hierarchical via parent/children. Soft-deleted like other aggregate roots.
// Lock state for an accounting period (`YYYY-MM`).
//
// Audit 2026-08 (P0): closure used to be *inferred* from the existence of
// `AccountBalance` rows for the month. A period with no prior balances and no
// activity produces no rows, so closing it silently no-opped — it never
// appeared in the closed list and postings dated into it were accepted. Lock
// state now lives in its own row, independent of whether any account moved.
model AccountingPeriod {
  period     String    @id // YYYY-MM
  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([closedAt])
}

model CostCenter {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  isActive  Boolean      @default(true)
  parentId  String?
  // Restrict: a parent cannot be deleted while children exist (forces explicit
  // re-parenting rather than silently orphaning or cascading the subtree).
  parent    CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  CostCenter[] @relation("CostCenterHierarchy")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  invoices     Invoice[]
  bills        VendorBill[]
  expenses     ExpenseReport[]
  journalLines JournalLine[]

  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
}
